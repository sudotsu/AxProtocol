# ═══════════════════════════════════════════════════════════════════════════
# AxProtocol Multi-Domain Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# OpenAI API Configuration
# ───────────────────────────────────────────────────────────────────────────
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-actual-key-here

# ───────────────────────────────────────────────────────────────────────────
# Model Tier Configuration
# ───────────────────────────────────────────────────────────────────────────
# DEV:    Fast iterations, lower cost (gpt-4o-mini)
# PREP:   Mid-grade quality (gpt-4o-turbo)  
# CLIENT: Full quality, highest cost (gpt-4o)

MODEL_DEV=gpt-4o-mini
MODEL_PREP=gpt-4o-turbo
MODEL_CLIENT=gpt-4o

# Default tier when TIER env var not specified
# Options: DEV, PREP, CLIENT
TIER=DEV

# ───────────────────────────────────────────────────────────────────────────
# Multi-Domain Configuration
# ───────────────────────────────────────────────────────────────────────────
# Leave blank to auto-detect domain from objective
# Set to force specific domain: marketing, technical, ops, creative, education
DOMAIN=

# Domain detection confidence threshold (0.0-1.0)
# Lower = more sensitive, Higher = more conservative
DOMAIN_CONFIDENCE_THRESHOLD=0.6

# Fallback domain when detection confidence is low
DOMAIN_FALLBACK=marketing

# ───────────────────────────────────────────────────────────────────────────
# Role Configuration
# ───────────────────────────────────────────────────────────────────────────
# Options: stable, experimental, dev
BUILD_TYPE=stable

# Enable role fallbacks if domain-specific roles missing
ROLE_FALLBACK_ENABLED=true

# ───────────────────────────────────────────────────────────────────────────
# Enforcement Modules (Optional - for full AxProtocol governance)
# ───────────────────────────────────────────────────────────────────────────
# These are optional - system works without them but has reduced features

# Enable TAES evaluation (Tri-Axis Evaluation Standard)
TAES_ENABLED=true

# Enable ledger logging (immutable audit trail)
LEDGER_ENABLED=true

# Enable CAM lease tracking (Controlled Autonomy Management)
CAM_ENABLED=true

# CAM lease duration in seconds (default: 180 = 3 minutes)
CAM_LEASE_DURATION=180

# ───────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────────────────────
# Log directory (relative to project root)
LOG_DIR=logs

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Save detailed session logs
SESSION_LOGGING=true

# Save KPI tracking data
KPI_LOGGING=true

# ───────────────────────────────────────────────────────────────────────────
# Performance & Quality
# ───────────────────────────────────────────────────────────────────────────
# Temperature for LLM calls (0.0-1.0, lower = more focused)
TEMPERATURE=0.4

# Max tokens per LLM response
MAX_TOKENS=1600

# Score threshold for quality validation (0-100)
SCORE_THRESHOLD=85

# IRD threshold for Reality Reconciliation Pass trigger (0.0-1.0)
IRD_THRESHOLD=0.5

# ───────────────────────────────────────────────────────────────────────────
# Multi-Domain Testing
# ───────────────────────────────────────────────────────────────────────────
# Test mode (skips actual LLM calls, uses mock data)
TEST_MODE=false

# Verbose domain detection output
DOMAIN_DETECTION_VERBOSE=false

# Show TAES metrics in console
SHOW_TAES_METRICS=true

# ───────────────────────────────────────────────────────────────────────────
# Optional: Additional AI Providers (Future Use)
# ───────────────────────────────────────────────────────────────────────────
# Uncomment and configure if you want to use these providers

# Anthropic Claude API
# ANTHROPIC_API_KEY=

# Google Gemini API
# GEMINI_API_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Web Interface (Streamlit Console - Optional)
# ───────────────────────────────────────────────────────────────────────────
# Port for Streamlit web console
PORT=8501

# Enable web interface
WEB_CONSOLE_ENABLED=false

# ───────────────────────────────────────────────────────────────────────────
# Advanced: Protocol Directives
# ───────────────────────────────────────────────────────────────────────────
# Path to protocol files (relative to project root)
PROTOCOL_DIR=../../protocol

# Directive layers to enforce (comma-separated)
# Options: core, add, aal, taes, rdl
ENFORCE_DIRECTIVES=core,add,aal,taes,rdl

# ───────────────────────────────────────────────────────────────────────────
# Development & Debugging
# ───────────────────────────────────────────────────────────────────────────
# Enable debug mode (more verbose output)
DEBUG=false

# Save raw LLM responses for debugging
SAVE_RAW_RESPONSES=false

# Dry run mode (validate without executing)
DRY_RUN=false

# ═══════════════════════════════════════════════════════════════════════════
# End of Configuration
# ═══════════════════════════════════════════════════════════════════════════